{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rahmat",
  "main": ".worker/index.mjs",
  "no_bundle": true,
  "build": { "command": "node scripts/build-worker.cjs" },
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "DEVICES", "class_name": "ReminderDevice" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReminderDevice"] }],
  "observability": { "enabled": false }
  // Set VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY and VAPID_SUBJECT with wrangler secret.
  // Never put secrets or subscriptions in this file or the public dist directory.
}
